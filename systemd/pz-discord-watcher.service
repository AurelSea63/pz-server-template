# systemd service for the real-time Discord watcher.
# Install:
#   1. Adjust the paths below (WorkingDirectory / ExecStart) to your repo.
#   2. sudo cp systemd/pz-discord-watcher.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now pz-discord-watcher
#   Logs: journalctl -u pz-discord-watcher -f

[Unit]
Description=Project Zomboid - Discord watcher (real-time notifications)
After=docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/path/to/repo
ExecStart=/path/to/repo/scripts/discord-watcher.sh
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
