# Secret configuration — copy to .env (git-IGNORED) and adapt.
# docker compose loads .env automatically.
# After any .env change: `docker compose up -d` (NOT `restart`, which doesn't reload .env).
#
# ⚠️ Avoid the characters | & / " and spaces in passwords.

# ============================================
# SECRETS (required)
# ============================================
# Built-in admin account (username "admin")
PZ_ADMIN_PASSWORD=changeme
# Server entry password. Empty = public server with no password.
PZ_SERVER_PASSWORD=changeme
# Remote RCON console (port 16211)
PZ_RCON_PASSWORD=changeme

# ============================================
# DISCORD (optional) — leave empty to disable
# ============================================
# General channel (admin, backups) — also used as fallback if the others are empty
DISCORD_WEBHOOK_URL=
# Connections / disconnections channel
DISCORD_CONNECT_WEBHOOK=
# Announcements channel (start / stop)
DISCORD_ANNOUNCE_WEBHOOK=
# Events channel (raids, hordes)
DISCORD_EVENT_WEBHOOK=
# Dedicated deaths channel (empty -> falls back to DISCORD_EVENT_WEBHOOK)
DISCORD_DEATH_WEBHOOK=
