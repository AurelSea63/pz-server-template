# Configuration secrète — copier en .env (IGNORÉ par git) et adapter.
# docker compose charge .env automatiquement.
# Après toute modif de .env : `docker compose up -d` (PAS `restart`, qui ne recharge pas .env).
#
# ⚠️ Éviter les caractères | & / " et les espaces dans les mots de passe.

# ============================================
# SECRETS (obligatoires)
# ============================================
# Compte admin intégré (username "admin")
PZ_ADMIN_PASSWORD=changeme
# Mot de passe d'entrée du serveur. Vide = serveur public sans mot de passe.
PZ_SERVER_PASSWORD=changeme
# Console RCON distante (port 16211)
PZ_RCON_PASSWORD=changeme

# ============================================
# DISCORD (optionnel) — laisser vide pour désactiver
# ============================================
# Salon général (admin, backups) — sert aussi de fallback si les autres sont vides
DISCORD_WEBHOOK_URL=
# Salon connexions / déconnexions
DISCORD_CONNECT_WEBHOOK=
# Salon annonces (démarrage / arrêt)
DISCORD_ANNOUNCE_WEBHOOK=
# Salon événements (morts, raids)
DISCORD_EVENT_WEBHOOK=
